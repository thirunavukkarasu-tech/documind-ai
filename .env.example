# Backend Configuration
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# MongoDB Configuration
MONGODB_URI=mongodb://admin:password@localhost:27017/documind-ai?authSource=admin

# JWT Configuration
JWT_ACCESS_SECRET=your-access-token-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173

# File Upload Configuration
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=uploads

# Frontend Configuration (not needed for backend, but listed for reference)
# VITE_API_BASE_URL=http://localhost:5000/api
